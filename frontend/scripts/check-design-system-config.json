{
  "unusedFilesCheck": {
    "entryPoints": [
      "src/main.tsx",
      "src/App.tsx"
    ],
    "ignorePatterns": [
      "**/*.d.ts"
    ],
    "excludedFiles": [
      {
        "path": "src/features/inbox/previewAdapter.ts",
        "reason": "inbox は現在 GAS 未接続のプレビュー状態のため、実装時の参照資料として残す。inbox の GAS 接続実装が完了したら除外を解除し、実際に import されているか確認すること。"
      }
    ]
  },
  "componentUsageCheck": {
    "rules": [
      { "component": "LineItemEditor", "pages": ["quotes", "orders"] },
      { "component": "Combobox", "pages": ["quotes", "orders"] },
      { "component": "TwoColumnLayout", "pages": ["quotes", "orders"] }
    ]
  },
  "featureComponentUsageCheck": {
    "comment": "帳票コンポーネントは各ドメインのページから正規 InvoiceDocument / QuoteDocument のみを参照すること（重複コンポーネント再発防止）",
    "rules": [
      { "component": "InvoiceDocument", "importPath": "features/documents/InvoiceDocument", "pages": ["orders"] },
      { "component": "QuoteDocument", "importPath": "features/documents/QuoteDocument", "pages": ["quotes"] },
      { "component": "buildOrderInvoiceProps", "importPath": "features/documents/invoiceUtils", "pages": ["orders"] }
    ]
  }
}

#!/bin/sh
# pre-push hook: main / develop への直接 push を禁止する
#
# 【有効化】
#   git config core.hooksPath .githooks
#
# 【重要】--no-verify は使用禁止。
#   このフックをバイパスするとサーバー側の検知 (GitHub Actions) のみが残る。
#   意図的なバイパスは CLAUDE.md の「不可逆操作」扱いとし、PO 確認必須。

PROTECTED_BRANCHES="main develop"

while read local_ref local_sha remote_ref remote_sha; do
  for protected_branch in $PROTECTED_BRANCHES; do
    if echo "$remote_ref" | grep -q "refs/heads/${protected_branch}$"; then
      echo ""
      echo "======================================================"
      echo "  ERROR: Direct push to '${protected_branch}' is FORBIDDEN"
      echo "------------------------------------------------------"
      echo "  This includes locally-created merge commits."
      echo "  Use a Pull Request merged on GitHub instead:"
      echo "    git checkout -b release/<topic>"
      echo "    git push origin release/<topic>"
      echo "    gh pr create --base ${protected_branch}"
      echo ""
      echo "  --no-verify の使用は禁止されています（CLAUDE.md 参照）"
      echo "======================================================"
      echo ""
      exit 1
    fi
  done
done

exit 0
